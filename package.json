{
  "name": "ttime",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "bun run --cwd apps/desktop tauri dev",
    "build:app": "bun run build:sidecar && bun run --cwd apps/desktop tauri build --config src-tauri/tauri.bundle.conf.json",
    "build:sidecar": "bun build --compile packages/cli/src/index.ts --outfile apps/desktop/src-tauri/binaries/ttime-cli-$(rustc --print host-tuple)",
    "demo:vault": "bun packages/cli/scripts/demo-vault.ts",
    "build:cli": "mkdir -p \"$HOME/.local/bin\" && bun build --compile packages/cli/src/index.ts --outfile \"$HOME/.local/bin/ttime\"",
    "check": "bun run check:format && bun run check:rust-format && bun run check:lint && bun run check:types && bun run check:clippy && bun run check:knip && bun run check:deps-rust && bun run test && bun run test:rust",
    "check:format": "prettier --check .",
    "check:rust-format": "cd apps/desktop/src-tauri && cargo fmt --all --check",
    "check:lint": "eslint . --max-warnings 0",
    "check:types": "tsc -b",
    "check:clippy": "cd apps/desktop/src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "check:knip": "knip",
    "check:deps-rust": "cd apps/desktop/src-tauri && cargo deny check && cargo machete",
    "fix": "prettier --write . && eslint . --fix && cd apps/desktop/src-tauri && cargo fmt --all",
    "test": "cd packages/core && bun test --coverage && cd ../cli && bun test && cd ../../apps/desktop && bun test",
    "test:rust": "cd apps/desktop/src-tauri && cargo test"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "79.0.0",
    "jiti": "2.7.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}

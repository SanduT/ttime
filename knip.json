{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["*.ts", "eslint/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["test/integration/support/{writer,hold-lock}.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/windows/*/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
